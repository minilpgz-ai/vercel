.env.local y sigue el README.\n\n---\n\n## Estructura del proyecto\n\n\nmarketplace-digital/\n├─ package.json\n├─ next.config.js\n├─ tailwind.config.js\n├─ postcss.config.js\n├─ .env.local (no subir)\n├─ README.md\n├─ /public\n├─ /pages\n│  ├─ _app.js\n│  ├─ index.js\n│  ├─ store.js\n│  ├─ product/[id].js\n│  ├─ seller/dashboard.js\n│  └─ api/\n│     ├─ paypal/create-order.js\n│     ├─ paypal/capture-order.js\n│     └─ binance/create-checkout.js\n├─ /components\n│  ├─ Header.jsx\n│  ├─ ProductCard.jsx\n│  └─ PaymentBox.jsx\n├─ /lib\n│  ├─ firebaseClient.js\n│  └─ firebaseAdmin.js\n└─ /styles\n   └─ globals.css\n\n\n---\n\n### package.json\n\njson\n{\n  \"name\": \"marketplace-digital\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"dev\": \"next dev\",\n    \"build\": \"next build\",\n    \"start\": \"next start\",\n    \"lint\": \"next lint\"\n  },\n  \"dependencies\": {\n    \"axios\": \"^1.4.0\",\n    \"firebase\": \"^10.0.0\",\n    \"firebase-admin\": \"^11.0.0\",\n    \"framer-motion\": \"^10.12.16\",\n    \"lucide-react\": \"^0.300.0\",\n    \"next\": \"13.5.6\",\n    \"react\": \"18.2.0\",\n    \"react-dom\": \"18.2.0\",\n    \"@paypal/react-paypal-js\": \"^8.0.0\"\n  },\n  \"devDependencies\": {\n    \"autoprefixer\": \"^10.4.14\",\n    \"postcss\": \"^8.4.23\",\n    \"tailwindcss\": \"^3.4.7\"\n  }\n}\n\n\n---\n\n### next.config.js\n\njs\n/** @type {import('next').NextConfig} */\nconst nextConfig = {\n  reactStrictMode: true,\n  images: { domains: ['via.placeholder.com'] },\n};\nmodule.exports = nextConfig;\n\n\n---\n\n### tailwind.config.js\n\njs\nmodule.exports = {\n  content: ['./pages/**/*.{js,jsx}', './components/**/*.{js,jsx}'],\n  theme: { extend: {} },\n  plugins: [],\n};\n\n\n---\n\n### postcss.config.js\n\njs\nmodule.exports = {\n  plugins: { tailwindcss: {}, autoprefixer: {} },\n};\n\n\n---\n\n### .env.local (ejemplo)\n\nenv\nNEXT_PUBLIC_FIREBASE_API_KEY=REPLACE\nNEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE\nNEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE\nNEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE\nNEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE\nNEXT_PUBLIC_FIREBASE_APP_ID=REPLACE\n\nFIREBASE_ADMIN_CLIENT_EMAIL=REPLACE\nFIREBASE_ADMIN_PRIVATE_KEY=\"REPLACE_WITH_ESCAPED_NEWLINES\"\nFIREBASE_ADMIN_PROJECT_ID=REPLACE\n\nPAYPAL_CLIENT_ID=REPLACE\nPAYPAL_CLIENT_SECRET=REPLACE\n\nBINANCE_PAY_API_KEY=REPLACE\nBINANCE_PAY_SECRET=REPLACE\nBINANCE_MERCHANT_ID=REPLACE\n\nBASE_URL=http://localhost:3000\n\n\n> Rellena con credenciales de sandbox/pruebas antes de pasar a producción.\n\n---\n\n## /lib/firebaseClient.js\n\njs\nimport { initializeApp, getApps } from 'firebase/app';\nimport { getAuth } from 'firebase/auth';\nimport { getFirestore } from 'firebase/firestore';\nimport { getStorage } from 'firebase/storage';\n\nconst firebaseConfig = {\n  apiKey: process.env.NEXT_PUBLIC_FIREBASE_API_KEY,\n  authDomain: process.env.NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,\n  projectId: process.env.NEXT_PUBLIC_FIREBASE_PROJECT_ID,\n  storageBucket: process.env.NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET,\n  messagingSenderId: process.env.NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID,\n  appId: process.env.NEXT_PUBLIC_FIREBASE_APP_ID,\n};\n\nif (!getApps().length) initializeApp(firebaseConfig);\n\nexport const auth = getAuth();\nexport const db = getFirestore();\nexport const storage = getStorage();\n\n\n---\n\n## /lib/firebaseAdmin.js\n\njs\nimport admin from 'firebase-admin';\n\nif (!admin.apps.length) {\n  admin.initializeApp({\n    credential: admin.credential.cert({\n      projectId: process.env.FIREBASE_ADMIN_PROJECT_ID,\n      clientEmail: process.env.FIREBASE_ADMIN_CLIENT_EMAIL,\n      privateKey: (process.env.FIREBASE_ADMIN_PRIVATE_KEY || '').replace(/\\\\n/g, '\\n'),\n    }),\n    storageBucket: process.env.NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET,\n  });\n}\n\nexport const adminDb = admin.firestore();\nexport const adminStorage = admin.storage();\nexport const adminAuth = admin.auth();\n\n\n---\n\n## /components/Header.jsx\n\njsx\nimport React from 'react';\nimport Link from 'next/link';\nimport { UploadCloud } from 'lucide-react';\n\nexport default function Header({ onOpenSeller }) {\n  return (\n    <header className=\"w-full border-b p-4 flex items-center justify-between bg-white\">\n      <div className=\"flex items-center gap-3\">\n        <Link href=\"/\" className=\"text-2xl font-bold\">MarketDigital</Link>\n        <nav className=\"hidden md:flex gap-4 text-sm text-gray-600\">\n          <Link href=\"/store\">Tienda</Link>\n          <a href=\"#features\">Características</a>\n        </nav>\n      </div>\n      <div className=\"flex items-center gap-3\">\n        <button className=\"btn\" onClick={onOpenSeller}><UploadCloud size={16} /> Vender</button>\n        <Link href=\"/seller/dashboard\"><a className=\"btn ghost\">Mi cuenta</a></Link>\n      </div>\n    </header>\n  );\n}\n\n\n---\n\n## /components/ProductCard.jsx\n\njsx\nimport React from 'react';\nimport Link from 'next/link';\n\nexport default function ProductCard({ product }) {\n  return (\n    <div className=\"p-4 border rounded-lg bg-white shadow-sm\">\n      <div className=\"flex justify-between items-start\">\n        <div>\n          <h3 className=\"font-semibold\">{product.title}</h3>\n          <p className=\"text-sm text-gray-500\">{product.author}</p>\n        </div>\n        <div className=\"text-lg font-bold\">${product.price}</div>\n      </div>\n      <p className=\"mt-3 text-sm text-gray-600\">{product.description}</p>\n      <div className=\"mt-4 flex justify-end\">\n        <Link href={`/product/${product.id}`}><a className=\"btn\">Ver</a></Link>\n      </div>\n    </div>\n  );\n}\n\n\n---\n\n## /components/PaymentBox.jsx\n\njsx\nimport React from 'react';\nimport { PayPalScriptProvider, PayPalButtons } from '@paypal/react-paypal-js';\nimport axios from 'axios';\n\nexport default function PaymentBox({ product, onComplete }) {\n  async function handleCreateBinance() {\n    try {\n      const res = await axios.post('/api/binance/create-checkout', { productId: product.id });\n      if (res.data?.url) window.location.href = res.data.url;\n    } catch (err) { console.error(err); alert('Error iniciando Binance Pay'); }\n  }\n\n  return (\n    <div className=\"p-3 border rounded-lg\">\n      <div className=\"mb-3\">Compra segura</div>\n      <div className=\"mb-3\">\n        <PayPalScriptProvider options={{ 'client-id': process.env.NEXT_PUBLIC_PAYPAL_CLIENT_ID || process.env.PAYPAL_CLIENT_ID, currency: 'USD' }}>\n          <PayPalButtons\n            style={{ layout: 'vertical' }}\n            createOrder={async (data, actions) => {\n              // Llamar a servidor para crear orden\n              const res = await fetch('/api/paypal/create-order', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ productId: product.id }) });\n              const json = await res.json();\n              return json.id; // orderID\n            }}\n            onApprove={async (data, actions) => {\n              // Enviar a servidor para capturar\n              const res = await fetch('/api/paypal/capture-order', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ orderId: data.orderID, productId: product.id }) });\n              const json = await res.json();\n              if (json?.downloadUrl) onComplete(json.downloadUrl);\n            }}\n          />\n        </PayPalScriptProvider>\n      </div>\n      <div className=\"mt-2\">\n        <button className=\"btn outline\" onClick={handleCreateBinance}>Pagar con Binance Pay</button>\n      </div>\n    </div>\n  );\n}\n\n\n---\n\n## /pages/_app.js\n\njsx\nimport '../styles/globals.css';\nimport Header from '../components/Header';\nimport { useState } from 'react';\n\nexport default function App({ Component, pageProps }) {\n  const [openSeller, setOpenSeller] = useState(false);\n  return (\n    <div className=\"min-h-screen bg-gray-50\">\n      <Header onOpenSeller={() => setOpenSeller(true)} />\n      <Component {...pageProps} />\n    </div>\n  );\n}\n\n\n---\n\n## /pages/index.js\n\njsx\nimport React from 'react';\n\nexport default function Home() {\n  return (\n    <main>\n      <section className=\"py-16 bg-gradient-to-r from-sky-50 to-white\">\n        <div className=\"container mx-auto px-4\">\n          <h1 className=\"text-4xl font-extrabold\">Vende y compra productos digitales — fácil, seguro y rápido</h1>\n          <p className=\"mt-4 text-gray-600\">Cursos, ebooks, plantillas, música y más.</p>\n        </div>\n      </section>\n      <section className=\"container mx-auto p-6\">\n        <h2 className=\"text-2xl font-bold mb-4\">¿Qué puedes vender?</h2>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <div className=\"p-4 border rounded-lg bg-white\">Ebooks</div>\n          <div className=\"p-4 border rounded-lg bg-white\">Cursos</div>\n          <div className=\"p-4 border rounded-lg bg-white\">Plantillas</div>\n        </div>\n      </section>\n    </main>\n  );\n}\n\n\n---\n\n
